// Updated prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String    @id @default(uuid())
  email                  String    @unique
  password               String?
  displayName            String
  profilePhotoUrl        String?
  provider               String
  googleId               String?   @unique
  role                   Role      @default(USER)
  isEmailVerified        Boolean   @default(false)
  emailVerificationToken String?
  passwordResetToken     String?
  passwordResetExpires   DateTime?

  // Profile completion
  isProfileCompleted Boolean          @default(false)
  interests          TravelInterest[] @relation("UserInterests")

  // User status and activity
  status     UserStatus @default(ACTIVE)
  lastActive DateTime?  @default(now())

  // Notification support
  fcmToken                String? // Firebase Cloud Messaging token
  notificationPreferences Json?   @default("{\"tripRequests\": true, \"missionAssignments\": true, \"tripUpdates\": true}")

  // Relationships
  tripsJoined       Trip[]            @relation("TripMembers")
  assignedMissions  AssignedMission[]
  payments          Payment[]
  createdTrips      Trip[]            @relation("CreatedTrips")
  joinRequests      JoinRequest[]
  tripAliases       TripAlias[]
  notificationHistory NotificationHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fcmToken])
  @@index([lastActive])
}

model Trip {
  id               String            @id @default(uuid())
  name             String
  description      String?           // Optional trip description
  theme            String            // "AESTHETIC" or "SECRET_AGENT"
  location         String @default("Unknown")
  code             String            @unique
  startDate        DateTime
  endDate          DateTime
  status           TripStatus        @default(UPCOMING)
  tripMode         String            @default("normal") // normal | fun
  
  // Trip management
  maxMembers       Int               @default(20)
  isPublic         Boolean           @default(false)
  
  // Statistics
  totalMissions    Int               @default(0)
  completedMissions Int              @default(0)
  
  // Relationships
  creatorId        String
  creator          User              @relation("CreatedTrips", fields: [creatorId], references: [id])
  members          User[]            @relation("TripMembers")
  assignedMissions AssignedMission[]
  album            Album?
  payments         Payment[]
  joinRequests     JoinRequest[]
  tripAliases      TripAlias[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([status])
  @@index([startDate])
}

model TripAlias {
  id     String @id @default(uuid())
  userId String
  tripId String
  alias  String

  user User @relation(fields: [userId], references: [id])
  trip Trip @relation(fields: [tripId], references: [id])

  @@unique([tripId, alias])
  @@unique([tripId, userId])
  @@index([tripId, alias])
}

model MissionTemplate {
  id             String        @id @default(uuid())
  title          String
  instruction    String
  location       String?
  sampleImageUrl String?
  category       MissionType?  // AESTHETIC or SECRET_AGENT
  level          MissionLevel  @default(NORMAL)
  isActive       Boolean       @default(true) // For enabling/disabling missions
  
  createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt @default(now())

  @@index([category])
  @@index([level])
  @@index([isActive])
}

model AssignedMission {
  id             String    @id @default(uuid())
  userId         String
  tripId         String
  title          String
  instruction    String
  category       String
  sampleImageUrl String?
  photoUrl       String?
  thumbnailUrl   String?   // Add this
  caption        String?   // Add this
  dayAssigned    Int?      // Add this - which day of the trip
  completed      Boolean   @default(false)
  submittedAt    DateTime?
  createdAt      DateTime  @default(now())
  
  user User @relation(fields: [userId], references: [id])
  trip Trip @relation(fields: [tripId], references: [id])

  @@index([userId, tripId])
  @@index([tripId, completed])
  @@index([completed])
  @@index([submittedAt])
  @@index([dayAssigned])  // Add this index
}

model Album {
  id        String   @id @default(uuid())
  tripId    String   @unique
  pdfUrl    String
  pdfHDUrl  String?
  printed   Boolean  @default(false)
  expiresAt DateTime? // When free access expires
  createdAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id])
}

model Payment {
  id        String   @id @default(uuid())
  userId    String
  tripId    String
  type      String   // "album_hd" or "album_print"
  amount    Int      // Amount in cents
  currency  String   @default("EUR")
  status    String   // "pending", "completed", "failed", "refunded"
  stripePaymentIntentId String? // Stripe payment ID
  timestamp DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  trip Trip @relation(fields: [tripId], references: [id])

  @@index([userId])
  @@index([tripId])
  @@index([status])
}

model TravelInterest {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  users     User[]   @relation("UserInterests")
}

model JoinRequest {
  id        String   @id @default(uuid())
  tripId    String
  userId    String
  alias     String
  status    String   @default("pending") // pending | approved | rejected
  message   String?  // Optional message from user
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  user User @relation(fields: [userId], references: [id])
  trip Trip @relation(fields: [tripId], references: [id])

  @@unique([tripId, userId])
  @@index([status])
  @@index([createdAt])
}

model Package {
  id        String   @id @default(uuid())
  name      String
  price     Float
  features  String[] // store as a string array
  status    PackageStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PrivacyPolicy {
  id         String   @id @default(uuid())
  contentEn  String?   // English content
  contentFr  String?   // French content
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("privacy_policies")
}

// New model for notification tracking
model NotificationHistory {
  id      String   @id @default(uuid())
  userId  String
  type    String   // "JOIN_REQUEST", "REQUEST_APPROVED", "NEW_MISSION", etc.
  title   String
  body    String
  data    Json?    // Additional notification data
  sentAt  DateTime @default(now())
  read    Boolean  @default(false)
  success Boolean  @default(true)
  error   String?  // Error message if sending failed

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sentAt])
  @@index([type])
  @@index([read])
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum TripStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

enum MissionType {
  AESTHETIC
  SECRET_AGENT
}

enum MissionLevel {
  NORMAL
  CRITICAL
}

enum PackageStatus {
  ACTIVE
  INACTIVE
}